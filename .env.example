# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GROQ_API_KEY: Groq AI LLM Completion endpoint key
GROQ_API_KEY="your_groq_api_key_here"

# ADMIN_ELEVATION_PASSWORD: Password required for elevation to Admin role
ADMIN_ELEVATION_PASSWORD="your_admin_elevation_password_here"

# JWT_SECRET: HMAC Secret Key for signing elevation JWT tokens
JWT_SECRET="your_secure_jwt_secret_key_here"

# CLOUDINARY CONFIGURATION FOR IMAGE PERSISTENCE
CLOUDINARY_CLOUD_NAME="your_cloud_name_here"
CLOUDINARY_API_KEY="your_cloudinary_api_key_here"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"
